{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "CoverForge",
  "version": "1.0.0",
  "identifier": "com.coverforge.app",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "title": "CoverForge - 封面编辑器",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
