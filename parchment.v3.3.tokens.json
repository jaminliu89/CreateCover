{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Parchment Design System Tokens",
  "version": "3.3.0",
  "meta": {
    "philosophy": {
      "humanistic": "Warm neutral surfaces with rich graphite text; no SaaS blue",
      "generousSpace": "Rhythm and negative space over heavy borders and containers",
      "quietRestraint": "Chrome remains quiet until user intent manifests",
      "epicProportions": "Classic editorial hierarchy with timeless contrast and scale"
    }
  },
  "color": {
    "surface": {
      "page": { "value": "#F9F8F6", "type": "color", "description": "Humanistic warm parchment base canvas" },
      "card": { "value": "#FFFFFF", "type": "color", "description": "Pure paper content layer" },
      "raised": { "value": "#F3F1ED", "type": "color", "description": "Quiet control container" },
      "floating": { "value": "#FFFFFF", "type": "color", "description": "Popover and dialog surface with soft diffusion shadow" },
      "overlay": { "value": "rgba(26, 26, 30, 0.4)", "type": "color", "description": "Backdrop dim overlay" }
    },
    "text": {
      "primary": { "value": "#1A1A1E", "type": "color", "description": "Near-black graphite text" },
      "secondary": { "value": "#6E6E78", "type": "color", "description": "Muted editorial metadata" },
      "tertiary": { "value": "#9A9AA5", "type": "color", "description": "Quiet chrome captions" },
      "inverse": { "value": "#FFFFFF", "type": "color", "description": "Inverse text for dark badges" }
    },
    "border": {
      "subtle": { "value": "#E8E6E1", "type": "color", "description": "Subtle organic division line" },
      "default": { "value": "#DCD9D2", "type": "color", "description": "Standard control border" },
      "strong": { "value": "#1A1A1E", "type": "color", "description": "Focused or active border" }
    },
    "action": {
      "primary": { "value": "#1A1A1E", "type": "color", "description": "Singular primary CTA" },
      "primaryHover": { "value": "#2E2E35", "type": "color" },
      "primaryText": { "value": "#FFFFFF", "type": "color" }
    },
    "ai": {
      "suggestion": { "value": "#FAF6F0", "type": "color", "description": "Warm subtle AI suggestion background" },
      "suggestionBorder": { "value": "#E6DEC6", "type": "color" },
      "processing": { "value": "#F3EFE6", "type": "color" },
      "diffAdded": { "value": "#E6F4EA", "type": "color", "description": "Botanical green for AI addition" },
      "diffRemoved": { "value": "#FCE8E6", "type": "color", "description": "Soft crimson for AI deletion" }
    }
  },
  "radius": {
    "control": { "value": "9px", "type": "dimension", "description": "Standard buttons, inputs, dropdowns" },
    "surface": { "value": "12px", "type": "dimension", "description": "Cards, modals, popovers" },
    "pill": { "value": "9999px", "type": "dimension", "description": "Semantic status badges ONLY" }
  },
  "shadow": {
    "floating": { "value": "0 8px 32px rgba(26, 26, 30, 0.06)", "type": "shadow" },
    "modal": { "value": "0 16px 48px rgba(26, 26, 30, 0.12)", "type": "shadow" }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif", "type": "fontFamily" },
      "serif": { "value": "'Source Serif Pro', Georgia, Cambria, 'Noto Serif SC', 'Songti SC', serif", "type": "fontFamily" },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", "type": "fontFamily" }
    },
    "cjk": {
      "lineHeight": { "value": 1.65, "type": "number" },
      "letterSpacing": { "value": "0.025em", "type": "dimension" }
    }
  }
}
