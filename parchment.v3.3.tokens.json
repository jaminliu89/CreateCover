{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Parchment Design System Tokens",
  "version": "3.3.0",
  "meta": {
    "philosophy": {
      "humanistic": "Modern minimalist pure palette; glacial grey canvas, crisp paper white, deep graphite text",
      "generousSpace": "Rhythm and negative space over heavy borders and containers",
      "quietRestraint": "Chrome remains quiet until user intent manifests",
      "epicProportions": "Classic editorial hierarchy with timeless contrast and scale"
    }
  },
  "color": {
    "surface": {
      "page": { "value": "#FAFAFA", "type": "color", "description": "Crisp glacial light grey canvas" },
      "card": { "value": "#FFFFFF", "type": "color", "description": "Pure crisp paper content layer" },
      "raised": { "value": "#F4F4F5", "type": "color", "description": "Quiet modern grey control container" },
      "floating": { "value": "#FFFFFF", "type": "color", "description": "Popover surface with micro diffusion shadow" },
      "overlay": { "value": "rgba(24, 24, 27, 0.4)", "type": "color", "description": "Backdrop dim overlay" }
    },
    "text": {
      "primary": { "value": "#18181B", "type": "color", "description": "Deep graphite black text" },
      "secondary": { "value": "#71717A", "type": "color", "description": "Muted modern metadata" },
      "tertiary": { "value": "#A1A1AA", "type": "color", "description": "Quiet chrome captions" },
      "inverse": { "value": "#FFFFFF", "type": "color", "description": "Inverse text for dark badges" }
    },
    "border": {
      "subtle": { "value": "#F4F4F5", "type": "color", "description": "Ultra subtle division line" },
      "default": { "value": "#E4E4E7", "type": "color", "description": "Standard modern border" },
      "strong": { "value": "#18181B", "type": "color", "description": "Focused or active border" }
    },
    "action": {
      "primary": { "value": "#18181B", "type": "color", "description": "Singular primary CTA" },
      "primaryHover": { "value": "#27272A", "type": "color" },
      "primaryText": { "value": "#FFFFFF", "type": "color" }
    },
    "ai": {
      "suggestion": { "value": "#F4F4F5", "type": "color", "description": "Modern crisp grey AI suggestion background" },
      "suggestionBorder": { "value": "#E4E4E7", "type": "color" },
      "processing": { "value": "#F4F4F5", "type": "color" },
      "diffAdded": { "value": "#ECFDF5", "type": "color", "description": "Crisp mint green for AI addition" },
      "diffRemoved": { "value": "#FEF2F2", "type": "color", "description": "Ice crimson for AI deletion" }
    }
  },
  "radius": {
    "control": { "value": "9px", "type": "dimension", "description": "Standard buttons, inputs, dropdowns" },
    "surface": { "value": "12px", "type": "dimension", "description": "Cards, modals, popovers" },
    "pill": { "value": "9999px", "type": "dimension", "description": "Semantic status badges ONLY" }
  },
  "shadow": {
    "floating": { "value": "0 8px 30px rgba(0, 0, 0, 0.04)", "type": "shadow" },
    "modal": { "value": "0 16px 48px rgba(0, 0, 0, 0.08)", "type": "shadow" }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif", "type": "fontFamily" },
      "serif": { "value": "'Source Serif Pro', Georgia, Cambria, 'Noto Serif SC', 'Songti SC', serif", "type": "fontFamily" },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", "type": "fontFamily" }
    },
    "cjk": {
      "lineHeight": { "value": 1.65, "type": "number" },
      "letterSpacing": { "value": "0.025em", "type": "dimension" }
    }
  }
}
